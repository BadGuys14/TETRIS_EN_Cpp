{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compiler Tetris",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Iinclude",
                "-ISFML/include",
                "src/main.cpp",
                "src/jeu.cpp",
                "src/grille.cpp",
                "src/Menu.cpp",
                "src/Piece.cpp",
                "-LSFML/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-o",
                "bin/debug/tetris.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "close": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Compiler et lancer Tetris",
            "type": "shell",
            "command": "${workspaceFolder}\\bin\\debug\\tetris.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Compiler Tetris",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "never",
                "panel": "dedicated",
                "close": true
            },
            "problemMatcher": []
        }
    ]
}
