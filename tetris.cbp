<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="TETRIS_EN_Cpp" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/debug/tetris" prefix_auto="1" extension_auto="1" />
				<Option working_dir="." />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-std=c++17" />
					<Add directory="include" />
					<Add directory="SFML/include" />
				</Compiler>
				<Linker>
					<Add library="sfml-graphics-d" />
					<Add library="sfml-window-d" />
					<Add library="sfml-system-d" />
					<Add directory="SFML/lib" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/tetris" prefix_auto="1" extension_auto="1" />
				<Option working_dir="." />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-std=c++17" />
					<Add directory="include" />
					<Add directory="SFML/include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="sfml-graphics" />
					<Add library="sfml-window" />
					<Add library="sfml-system" />
					<Add directory="SFML/lib" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-std=c++17" />
			<Add directory="include" />
			<Add directory="SFML/include" />
		</Compiler>
		<Linker>
			<Add directory="SFML/lib" />
		</Linker>
		<Unit filename="include/Menu.h" />
		<Unit filename="include/Palette.h" />
		<Unit filename="include/Piece.hpp" />
		<Unit filename="include/grille.hpp" />
		<Unit filename="include/jeu.hpp" />
		<Unit filename="src/Menu.cpp" />
		<Unit filename="src/Piece.cpp" />
		<Unit filename="src/grille.cpp" />
		<Unit filename="src/jeu.cpp" />
		<Unit filename="src/main.cpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
